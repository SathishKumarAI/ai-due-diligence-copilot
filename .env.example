# Provider: "ollama" (free/local, default), "claude", or "openai".
PROVIDER=ollama

# The generator and the embedder are chosen independently. Leave both unset and each
# follows PROVIDER, which is the original single-switch behaviour. Set either to mix,
# e.g. a cloud generator over local embeddings:
#   LLM_PROVIDER=claude
#   EMBED_PROVIDER=ollama
# Changing the EMBEDDING model or provider selects a different Chroma collection —
# vectors are only meaningful to the model that made them — so re-run the ingest.
# LLM_PROVIDER=
# EMBED_PROVIDER=

# Fully-local guard. true (default) = refuse any cloud provider, for whichever half
# selects it, even if PROVIDER names it. An "openai" provider pointed at localhost
# (vLLM / TGI / LM Studio) counts as local and is allowed. Set false to permit cloud.
LOCAL_ONLY=true

# --- Ollama (open-source path) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.1:8b
# Any sentence-transformers model on the Hub. Bigger is not automatically better on a
# corpus this small — measure with `make eval` before keeping a change.
#   BAAI/bge-small-en-v1.5   384 dim, the default
#   BAAI/bge-large-en-v1.5   1024 dim
#   intfloat/e5-large-v2     1024 dim
#   nomic-ai/nomic-embed-text-v1.5
HF_EMBED_MODEL=BAAI/bge-small-en-v1.5

# --- compute device for embeddings + reranker (local path) ---
# "auto" = cuda -> mps -> cpu; or force "cpu" | "cuda" | "mps". (Ollama picks its own GPU.)
# The GPU docker overlay sets these to "cuda". See docs/DEPLOYMENT.md.
EMBED_DEVICE=auto
RERANK_DEVICE=auto

# --- Claude path (only needed if PROVIDER=claude) ---
# ANTHROPIC_API_KEY=
# VOYAGE_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
VOYAGE_MODEL=voyage-3.5

# --- OpenAI-compatible path (only needed if PROVIDER=openai) ---
# One adapter for every backend that speaks the OpenAI wire format. Set OPENAI_BASE_URL
# to reach something other than OpenAI itself; leave it empty for api.openai.com.
#   Groq       https://api.groq.com/openai/v1
#   Together   https://api.together.xyz/v1
#   DeepSeek   https://api.deepseek.com/v1
#   vLLM/TGI   http://localhost:8000/v1      <- local, allowed under LOCAL_ONLY
#   LM Studio  http://localhost:1234/v1      <- local, allowed under LOCAL_ONLY
#   Ollama     http://localhost:11434/v1     <- local, allowed under LOCAL_ONLY
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# --- API security (leave API_KEY empty to run auth-free locally) ---
# API_KEY=change-me-in-production
RATE_LIMIT_PER_MIN=60

# --- caching ---
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600

# --- chunking ---
# 400, not 1000: at 1000 each sample document fitted inside a single chunk, so every
# vector was a document-level average and single facts were buried. See app/config.py
# for the measurements behind this number.
CHUNK_SIZE=400
CHUNK_OVERLAP=80

# --- retrieval (F16 hybrid: BM25 + dense, fused with RRF) ---
RETRIEVAL_MODE=hybrid          # "hybrid" or "dense"
RETRIEVE_FETCH_K=20            # candidates each arm fetches before fusion / rerank
MAX_CHUNKS_PER_SOURCE=2       # cap of top_k slots any one document may occupy
RRF_K=60                       # Reciprocal Rank Fusion constant

# --- re-ranking (F17 cross-encoder; off by default) ---
# Any cross-encoder on the Hub. Unlike the embedding model, changing this does not
# invalidate the index — the reranker only reorders what retrieval already found.
#   cross-encoder/ms-marco-MiniLM-L-6-v2   the default, fastest
#   BAAI/bge-reranker-base
#   BAAI/bge-reranker-v2-m3                strongest, multilingual, slowest
RERANK_ENABLED=false
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- upload (F18) ---
MAX_UPLOAD_MB=25

# --- conversation memory (F19) ---
HISTORY_MAX_TURNS=6            # recent turns kept when condensing follow-ups

# --- OCR ingestion (F20; local Tesseract, no keys) ---
OCR_ENABLED=true              # OCR images + scanned PDFs during ingest
OCR_LANG=eng                  # tesseract language pack(s), e.g. "eng+deu"
OCR_DPI=200                   # rasterization DPI for scanned PDF pages
OCR_MIN_CHARS_PER_PAGE=40     # below this avg -> a PDF is treated as scanned

# --- cleaning pipeline (F21) ---
CLEAN_ENABLED=true            # normalize + strip noise between load and split
DEDUPE_ENABLED=true           # drop near-duplicate chunks after splitting
DEDUPE_THRESHOLD=0.9          # Jaccard(shingles) >= this => duplicate
