# Base URL of the FastAPI backend (the RAG service)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Public GitHub repo whose Releases power the "What's New" page
NEXT_PUBLIC_GITHUB_REPO=SathishKumarAI/ai-due-diligence-copilot

# Optional: API key, only if the backend has auth enabled
# NEXT_PUBLIC_API_KEY=

# Optional: where the Embedding Projector is served, to show an 'Embedding map'
# link in the nav. The projector renders a STATIC export from
# scripts/export_embeddings.py, so it does not update when documents are ingested
# or uploaded — re-run the exporter. See docs/EMBEDDING-MAP.md.
# NEXT_PUBLIC_EMBEDDING_MAP_URL=http://127.0.0.1:8189/?config=rag_data/config.json
